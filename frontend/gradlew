#!/bin/sh
# Gradle wrapper launcher (POSIX). Usa gradle/wrapper/gradle-wrapper.jar.
app_path=$0
while [ -h "$app_path" ]; do
    ls=$(ls -ld "$app_path"); link=${ls#*' -> '}
    case $link in /*) app_path=$link ;; *) app_path=$(dirname "$app_path")/$link ;; esac
done
APP_HOME=$(cd "$(dirname "$app_path")" > /dev/null && pwd -P) || exit
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then JAVACMD=$JAVA_HOME/bin/java; else JAVACMD=java; fi
command -v "$JAVACMD" > /dev/null 2>&1 || { echo "ERROR: java no encontrado; define JAVA_HOME." >&2; exit 1; }
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar
exec "$JAVACMD" ${DEFAULT_JVM_OPTS:-"-Xmx64m" "-Xms64m"} ${JAVA_OPTS} ${GRADLE_OPTS} \
    "-Dorg.gradle.appname=gradlew" -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain "$@"
